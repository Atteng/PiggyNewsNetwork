// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// 1. Users & Authentication
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  role          String    @default("user") // 'admin', 'editor', 'user'
  avatarUrl     String?   @map("avatar_url")
  emailVerified DateTime? @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  articles      Article[]
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
 
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
  @@map("accounts")
}
 
model Session {
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  @@map("sessions")
}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@id([identifier, token])
  @@map("verification_tokens")
}

// 2. Articles (News & Proposals)
model Article {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  excerpt     String?
  content     String?   @db.Text
  category    Category
  thumbnailUrl String?  @map("thumbnail_url")
  authorId    String?   @map("author_id")
  featured    Boolean   @default(false)
  views       Int       @default(0)
  readTime    String?   @map("read_time")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  status      String    @default("draft") // 'draft', 'published', 'archived'
  
  author      User?     @relation(fields: [authorId], references: [id])
  proposal    Proposal?

  @@index([category])
  @@index([publishedAt(sort: Desc)])
  @@index([slug])
  @@map("articles")
}

enum Category {
  Proposal
  Temp_Check @map("Temp Check")
  General
  Marketing
  Operations
}

// 3. Governance Clusters (Porktocracy)
model Cluster {
  id            String      @id @default(uuid())
  name          String
  description   String?     @db.Text
  memberCount   Int         @default(0) @map("member_count")
  proposalCount Int         @default(0) @map("proposal_count")
  radius        Int         @default(80)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  subCircles    SubCircle[]

  @@map("clusters")
}

model SubCircle {
  id        String   @id @default(uuid())
  clusterId String   @map("cluster_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  
  cluster   Cluster  @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@index([clusterId])
  @@map("sub_circles")
}

// 4. Brand Assets (Character Library)
model BrandAsset {
  id          String      @id @default(uuid())
  title       String
  description String?     @db.Text
  category    AssetCategory
  thumbnailUrl String?    @map("thumbnail_url")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  files       AssetFile[]

  @@map("brand_assets")
}

enum AssetCategory {
  banners
  brand_kit  @map("brand-kit")
  mascot_kit @map("mascot-kit")
}

model AssetFile {
  id        String   @id @default(uuid())
  assetId   String   @map("asset_id")
  name      String
  fileUrl   String   @map("file_url")
  format    String
  fileSize  String   @map("file_size")
  createdAt DateTime @default(now()) @map("created_at")

  asset     BrandAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_files")
}

// 5. Documentation Pages
model DocPage {
  id          String    @id @default(uuid())
  slug        String    @unique
  category    String
  title       String
  description String?   @db.Text
  content     String    @db.Text
  icon        String?
  orderIndex  Int       @default(0) @map("order_index")
  parentId    String?   @map("parent_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  parent      DocPage?  @relation("DocHierarchy", fields: [parentId], references: [id])
  children    DocPage[] @relation("DocHierarchy")

  @@index([category, orderIndex])
  @@index([slug])
  @@map("doc_pages")
}

// 6. Static Pages (Character Library Content, etc.)
model StaticPage {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  sections  Json     // Array of section objects
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@map("static_pages")
}

// 7. Hero Content
model HeroContent {
  id            String   @id @default(uuid())
  badgeText     String?  @map("badge_text")
  headlineLine1 String?  @map("headline_line_1")
  headlineLine2 String?  @map("headline_line_2")
  headlineLine3 String?  @map("headline_line_3")
  tagline       String?  @db.Text
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("hero_content")
}

// 8. Site Settings
model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// 9. Proposals & Voting
model Proposal {
  id          String    @id @default(uuid())
  articleId   String    @unique @map("article_id")
  snapshotUrl String?   @map("snapshot_url")
  votesFor    Int       @default(0) @map("votes_for")
  votesAgainst Int      @default(0) @map("votes_against")
  quorum      Int?
  status      String    @default("PENDING") // 'PENDING', 'ACTIVE', 'CLOSED'
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")

  article     Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("proposals")
}
